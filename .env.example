# PreAuth backend environment.
# Copy to .env and fill in real values. On the droplet this lives at
# /opt/preauth/.env (docker-compose.prod.yml loads it via `env_file: .env`).
# NEVER commit the real .env. config/settings.py uses extra="ignore", so only
# the documented keys below are read.

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- AMAN HMO source DB (MySQL) ---
AMAN_DB_HOST=
AMAN_DB_PORT=3306
AMAN_DB_USER=
AMAN_DB_PASSWORD=
AMAN_DB_NAME=

# --- Our DB (PostgreSQL) ---
OUR_DB_URL=

# --- Security ---
WEBHOOK_SECRET=
JWT_SECRET=

# --- Dashboard / CORS ---
DASHBOARD_BASE_URL=https://dashboard.saasprolabs.io
CORS_ORIGINS=https://dashboard.saasprolabs.io,http://localhost:5173,http://localhost:5174

# --- AMAN outbound callback (agent decision -> AMAN) ---
AMAN_CALLBACK_ENABLED=false
AMAN_DECISIONS_URL=
KPA_KEY=

# --- Agent control ---
# Set false to pause automated decisions during stabilization.
AGENT_ENABLED=false

# --- Applied-mode guardrails (SAA-61) ---
APPLIED_MODE_ENABLED=false
APPLIED_MAX_ITEM_AMOUNT=25000
APPLIED_MAX_PA_AMOUNT=100000
APPLIED_CATEGORY_ALLOWLIST=3,7,8
APPLIED_CATEGORY_DENYLIST=4
APPLIED_CARETYPE_DENYLIST=1,3
APPLIED_PLAN_DENYLIST=platinum,platinum plus,platinum+
APPLIED_REQUIRE_HIGH_CONFIDENCE=true
APPLIED_UTILIZATION_THRESHOLD=0.80

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Observability / Sentry (SAA-83) ---
# DSN is a client key (safe to expose); leave empty to disable Sentry (no-op).
SENTRY_DSN=
# One of: production | staging | development. Set per deploy environment.
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_JSON=true

# --- Slack alerts ---
# Incoming Webhook URL from the "PreAuth Alerts" Slack app.
# THIS IS A REAL SECRET (anyone with it can post to your channel). Empty = disabled.
SLACK_WEBHOOK_URL=

# --- Google OAuth / Gmail integration ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_PUBSUB_TOPIC_NAME=
GMAIL_WATCH_LABEL_IDS=INBOX
GMAIL_PUBSUB_VERIFICATION_TOKEN=
